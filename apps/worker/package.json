{
  "name": "@manly/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Procesos en segundo plano: recordatorios, expiraciones y bandeja de salida",
  "scripts": {
    "dev": "tsx watch src/principal.ts",
    "build": "tsc --build",
    "start": "node dist/principal.js",
    "typecheck": "tsc --noEmit --tsBuildInfoFile .typecheck.tsbuildinfo",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "limpiar": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@manly/base-datos": "workspace:*",
    "@manly/contratos": "workspace:*",
    "luxon": "^3.7.2",
    "pg-boss": "^10.1.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@manly/configuracion": "workspace:*",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.10.2",
    "drizzle-orm": "^0.38.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
