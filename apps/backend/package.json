{
  "name": "@manly/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de reservas de Manly",
  "scripts": {
    "dev": "nest start --watch",
    "dev:memoria": "nest build && node dist/principal-memoria.js",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit --tsBuildInfoFile .typecheck.tsbuildinfo",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:observar": "vitest",
    "limpiar": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@manly/base-datos": "workspace:*",
    "@manly/contratos": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.3.0",
    "helmet": "^8.0.0",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@manly/configuracion": "workspace:*",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.10.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.17.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
