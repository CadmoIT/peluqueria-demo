# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copiar a .env y completar.
# Nunca versionar el .env real.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
ZONA_HORARIA=America/Argentina/Buenos_Aires

# ── Base de datos (PostgreSQL / Neon) ─────────────────────────
# La API usa la conexión agrupada (pooled).
DATABASE_URL=postgresql://manly:manly@localhost:5432/manly
# El worker y las migraciones usan la conexión DIRECTA.
# pg-boss necesita locks de sesión y el pooler de Neon (PgBouncer en
# modo transacción) los rompe. En Neon son dos endpoints distintos.
DATABASE_URL_DIRECTA=postgresql://manly:manly@localhost:5432/manly

# ── API ───────────────────────────────────────────────────────
API_PUERTO=3001
API_PREFIJO=api/v1
ORIGENES_PERMITIDOS=http://localhost:3000

# ── Web ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_URL_PUBLICA=http://localhost:3000

# ── Sesiones y tokens ─────────────────────────────────────────
# Generar con: openssl rand -base64 48
SECRETO_SESION=
SECRETO_TOKEN_RESERVA=

# ── Mercado Pago (Checkout Pro) ───────────────────────────────
# Sin MP_ACCESS_TOKEN se usa la pasarela SIMULADA: el flujo funciona entero
# pero no se cobra dinero real. El arranque avisa cuál quedó activa.
# Los tokens que empiezan con TEST- activan el sandbox.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_SECRETO_WEBHOOK=secreto-de-desarrollo

# Desde dónde alcanza la pasarela a esta API para notificar. En desarrollo hace
# falta un túnel público (ngrok o similar) para recibir webhooks reales.
URL_PUBLICA_API=http://localhost:3001/api/v1

# ── WhatsApp Cloud API ────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_ID_TELEFONO=
WHATSAPP_ID_CUENTA_NEGOCIO=
WHATSAPP_TOKEN_VERIFICACION=

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_REMITENTE=reservas@manly.com.ar

# ── Observabilidad ────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
