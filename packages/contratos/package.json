{
  "name": "@manly/contratos",
  "version": "0.1.0",
  "private": true,
  "description": "Contratos Zod compartidos entre la web, la API y el worker",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit --tsBuildInfoFile .typecheck.tsbuildinfo",
    "lint": "eslint src",
    "limpiar": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@manly/configuracion": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}
