# Normaliza los finales de línea: LF en el repositorio, sin importar el sistema.
* text=auto eol=lf

# Archivos binarios: no tocar.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# El lockfile es generado: no cuenta para las estadísticas del repositorio.
pnpm-lock.yaml linguist-generated=true -diff
