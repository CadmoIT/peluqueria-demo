{
  "name": "manly",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma web y de reservas de Manly",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "formato": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "formato:verificar": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "bd:generar": "pnpm --filter @manly/base-datos generar",
    "bd:migrar": "pnpm --filter @manly/base-datos migrar",
    "bd:semillas": "pnpm --filter @manly/base-datos semillas",
    "limpiar": "turbo run limpiar && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
