# Windows restringe la creación de symlinks salvo con Modo Desarrollador o admin,
# así que se instala con node_modules plano en vez del enlazado por defecto de pnpm.
# Si se activa el Modo Desarrollador de Windows, se puede quitar esta línea y
# recuperar el aislamiento estricto de dependencias que da pnpm.
node-linker=hoisted

# Los paquetes internos se resuelven desde el workspace antes de ir al registro.
link-workspace-packages=true
prefer-workspace-packages=true

auto-install-peers=true
strict-peer-dependencies=false
